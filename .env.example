NEXT_PUBLIC_API_URL=http://localhost:5000

# Required. Random, 32+ characters. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Must be the same database the backend (BookNook-Backend) uses: the API verifies login sessions against it.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/booknook?retryWrites=true&w=majority
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here
GOOGLE_CLIENT_ID=your_google_cliend_ID
GOOGLE_CLIENT_SECRET=your_client_secret
